{\n  "$schema": "http://json-schema.org/draft-07/schema#",\n  "title": "Config Schema",\n  "type": "object",\n  "properties": {\n    "mission": {\n      "type": "object",\n      "properties": {\n        "ordered": {\n          "enum": [true, false],\n          "description": "Indicates if the missions should be executed in order."\n        },\n        "otherProperty": {\n          "type": "string"\n        }\n      },\n      "required": false\n    },\n    "layout": {\n      "type": "object",\n      "properties": {\n        "devices": {\n          "type": "array",\n          "items": {\n            "type": "object",\n            "properties": {\n              "accessoryCategory": {\n                "type": "string"\n              },\n              "idleWatchInterval": {\n                "type": "integer"\n              }\n            },\n            "required": []\n          }\n        }\n      }\n    },\n    "cleanBehaviour": {\n      "type": "object",\n      "properties": {\n        "someCleanBehaviourProp": {\n          "type": "string"\n        }\n      }\n    }\n  }\n}