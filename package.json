{
  "name": "@homebridge-plugins/homebridge-roomba",
  "displayName": "Roomba",
  "type": "module",
  "version": "2.1.0",
  "description": "homebridge-plugin for Roomba devices",
  "author": {
    "name": "RayanKhan"
  },
  "license": "MIT",
  "homepage": "https://github.com/homebridge-plugins/homebridge-roomba#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/homebridge-plugins/homebridge-roomba.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-roomba/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "iRobot",
    "Roomba"
  ],
  "main": "./dist/index.js",
  "engines": {
    "homebridge": "^1.9.0 || ^2.0.0 || ^2.0.0-beta.23 || ^2.0.0-alpha.37",
    "node": "^20 || ^22 || ^24"
  },
  "maintainers": [
    {
      "name": "karlvr"
    }
  ],
  "scripts": {
    "check": "npm install && npm outdated",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "watch": "npm run build && npm run plugin-ui && npm link && nodemon",
    "plugin-ui": "rsync ./src/homebridge-ui/public/index.html ./dist/homebridge-ui/public/",
    "build": "npm run clean && tsc && npm run plugin-ui",
    "prepublishOnly": "npm run lint && npm run build && npm run plugin-ui && npm run docs && npm run docs:lint",
    "postpublish": "npm run clean && npm ci",
    "clean": "shx rm -rf ./dist",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "roomba:getpassword": "get-roomba-password",
    "roomba:getlastcommand": "node ./dist/lastcommand.js",
    "docs": "typedoc",
    "docs:lint": "typedoc --emit none --treatWarningsAsErrors"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.0.1",
    "dorita980": "npm:@karlvr/dorita980@3.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.1",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^3.1.10",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.12",
    "typescript": "^5.9.2",
    "vitest": "^3.0.7"
  }
}